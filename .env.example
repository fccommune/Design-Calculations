# Copy this file to .env and fill in real values.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/flaskauthtemplate

# Outgoing mail (used for the "Forgot Password" OTP email)
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@example.com

# GAD Automation (Globe valve) - SolidWorks template/block file locations.
# Only needed on the machine that actually has SolidWorks installed and
# generates drawings. Point these at wherever the .DRWDOT template and the
# .SLDBLK block libraries live (was hardcoded to E:\SOLIDWORKS Automation
# File\... in the old WinForms app).
GAD_TEMPLATE_PATH=\\IRN-DC-FS\020.Common Folder\IT\SOLIDWORKS Automation File\FCC GAD Template.DRWDOT
GAD_BLOCK_DIR=\\IRN-DC-FS\020.Common Folder\IT\SOLIDWORKS Automation File\BLOCK FILE
GAD_HOOKUP_BLOCK_DIR=\\IRN-DC-FS\020.Common Folder\IT\SOLIDWORKS Automation File\Hook Up Blockfile
GAD_CROSSSEC_BLOCK_DIR=\\IRN-DC-FS\020.Common Folder\IT\SOLIDWORKS Automation File\CrossSec
GAD_NAMEPLATE_BLOCK_PATH=\\IRN-DC-FS\020.Common Folder\IT\SOLIDWORKS Automation File\NamePlate\MSD.SLDBLK
# Where exported PDFs get written. Leave blank to default to the Desktop.
GAD_OUTPUT_DIR=
